# Copy to .env and fill in your own values. .env is gitignored — never commit it.
#   cp .env.example .env

# Brevo API key, from Brevo -> SMTP & API -> API Keys.
BREVO_API_KEY=xkeysib-your-key-here

# Default sender. Must be a verified sender in your Brevo account.
# Override per run with -from / -from-name.
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Example
